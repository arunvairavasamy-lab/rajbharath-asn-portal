<!DOCTYPE html>
<html>
<head>
  <title>ASN <%= asn.asn_number %> - Rajbharath Foundations</title>
  <link rel="stylesheet" href="/css/print.css">
</head>
<body>

  <div class="print-button">
    <button onclick="window.print()">Print / Save as PDF</button>
  </div>

  <div class="doc-box">

    <div class="doc-header">
      <div class="doc-header-left">
        <img src="/images/logo.jpg" alt="Rajbharath Foundations">
        <div class="company-name">
          Rajbharath Foundations (P) Ltd<br>
          <span style="font-weight: normal; font-size: 12px;">
            Plot No: RNS 19/2, Renault Nissan Supplier Park,<br>
            Sipcot Industrial Park, Oragadam, Kancheepuram - 603204
          </span>
        </div>
      </div>
      <div class="doc-header-right">
        <h2>ADVANCE SHIPMENT NOTICE</h2>
        <p><strong>ASN No:</strong> <%= asn.asn_number %></p>
        <p><strong>Date:</strong> <%= asn.invoice_date %></p>
      </div>
    </div>

    <table class="info-table">
      <tr>
        <td class="label">PO Number</td>
        <td><%= po.po_number %></td>
        <td class="label">Invoice Number</td>
        <td><%= asn.invoice_number %></td>
      </tr>
      <tr>
        <td class="label">Supplier</td>
        <td><%= supplier.name %> (<%= supplier.code %>)</td>
        <td class="label">Invoice Date</td>
        <td><%= asn.invoice_date %></td>
      </tr>
      <tr>
        <td class="label">Transport Method</td>
        <td><%= asn.transport_method %></td>
        <td class="label">Vehicle Number</td>
        <td><%= asn.vehicle_number %></td>
      </tr>
    </table>

    <div class="items-section">
      <table class="items-table">
        <tr>
          <th style="width: 8%;">Sl No.</th>
          <th>Part Description</th>
          <th style="width: 15%;">Quantity</th>
          <th style="width: 12%;">UOM</th>
          <th style="width: 20%;">Amount with Tax</th>
        </tr>
        <% items.forEach(function(item, index) { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= item.part_description %></td>
            <td class="num"><%= item.qty %></td>
            <td><%= item.uom %></td>
            <td class="num"><%= item.amount_with_tax %></td>
          </tr>
        <% }); %>
      </table>
    </div>

    <div class="footer-section">
      <div class="qr-block">
        <img src="<%= qrDataUrl %>" alt="ASN QR Code" width="130" height="130">
        <p><%= asn.asn_number %></p>
      </div>
      <div class="signature-block">
        <p>For Rajbharath Foundations (P) Ltd</p>
        <div class="signature-line"></div>
        <p>Authorised Signatory</p>
      </div>
    </div>

  </div>

</body>
</html>